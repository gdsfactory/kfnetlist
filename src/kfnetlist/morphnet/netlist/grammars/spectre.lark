// Spectre netlist grammar (LALR)
// Expects pre-processed input: comments stripped, continuations joined,
// semicolons injected after each non-block/non-structural statement.

start: toplevel_item*

?toplevel_item: subckt_def
              | instance_stmt _SEMI
              | model_stmt _SEMI
              | parameters_stmt _SEMI
              | include_stmt _SEMI
              | save_stmt _SEMI
              | section_def

// ── Subcircuit definition ──────────────────────────────────────────────
subckt_def: _SUBCKT_KW IDENT "(" port_decl* ")" param_assign* subckt_body _ENDS_KW IDENT?
_SUBCKT_KW: "subckt"
_ENDS_KW: "ends"

subckt_body: body_item*
?body_item: instance_stmt _SEMI
          | model_stmt _SEMI
          | parameters_stmt _SEMI
          | include_stmt _SEMI
          | save_stmt _SEMI
          | subckt_def

port_decl: IDENT

// ── Instance: name (net1 net2 ...) cellname param=val ... ──────────────
instance_stmt: IDENT "(" net_ref* ")" IDENT param_assign*

net_ref: NET_NAME

// ── model statement ────────────────────────────────────────────────────
model_stmt: _MODEL_KW IDENT IDENT "(" param_assign* ")"
_MODEL_KW: "model"

// ── parameters block ───────────────────────────────────────────────────
parameters_stmt: _PARAMETERS_KW param_assign+
_PARAMETERS_KW: "parameters"

// ── include ────────────────────────────────────────────────────────────
include_stmt: _INCLUDE_KW FILE_PATH include_opt*
include_opt: IDENT "=" IDENT
_INCLUDE_KW: "include"

// ── section/endsection (library sections) ──────────────────────────────
section_def: _SECTION_KW "=" IDENT section_body _ENDSECTION_KW
_SECTION_KW: "section"
_ENDSECTION_KW: "endsection"
section_body: toplevel_item*

// ── save statement ─────────────────────────────────────────────────────
save_stmt: _SAVE_KW net_ref+
_SAVE_KW: "save"

// ── Parameter assignment: name=value ───────────────────────────────────
param_assign: IDENT "=" param_value
?param_value: VALUE      -> pvalue_value
            | LIST       -> pvalue_value   // `wave=[0 0 1n 1.8]`
            | QSTRING    -> pvalue_string

// ── Terminals ──────────────────────────────────────────────────────────
_SEMI: ";"
// A number, a name or a bare expression (`w=2*l+1u`), ending at the next `name=`,
// `;` or unmatched `)`: runs of non-space text (parentheses may hold spaces, two
// levels deep) joined by operators, with spaces allowed only around an operator.
VALUE: /(?:[^\s;()=\"']|\((?:[^()]|\([^()]*\))*\))+(?:[ \t]*[-+*\/%<>=!&|?:]+[ \t]*(?:[^\s;()=\"']|\((?:[^()]|\([^()]*\))*\))+)*/
NET_NAME: /[A-Za-z0-9_.\[\]:!#]+/
IDENT: /[A-Za-z_][A-Za-z0-9_.\[\]:!#]*/
QSTRING: /\"[^\"]*\"/ | /'[^']*'/
LIST.2: /\[[^\]\n;]*\]/  // one line: a list cut by a newline fails loudly
FILE_PATH: /\"[^\"]*\"/ | /'[^']*'/ | /[^\s\"';()]+/

%ignore /[ \t\r\n]+/
